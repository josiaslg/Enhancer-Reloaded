#include "resource.h"
#include <winver.h>
IDB_SKIN BITMAP "res\\skin_base.bmp"
IDI_MAIN ICON "res\\hat.ico"
IDI_OFF  ICON "res\\hat_off.ico"
IDR_APODLL RCDATA "EnhancerAPO.dll"
1 24 "EnhancerReloaded.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "josiaslg"
      VALUE "FileDescription", "Enhancer Reloaded - control panel for the Enhancer APO"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "EnhancerReloaded"
      VALUE "LegalCopyright", "Copyright (c) 2026 josiaslg. BSD 2-Clause License."
      VALUE "OriginalFilename", "EnhancerReloaded.exe"
      VALUE "ProductName", "Enhancer Reloaded"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
